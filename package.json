{
  "name": "room-research",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/preview.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/prerender.mjs && node scripts/build-public.mjs",
    "build:pages": "tsc -b && vite build --outDir dist && node scripts/prerender.mjs dist/index.html",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/access.test.mjs",
    "test:pages": "node --test tests/pages.test.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
